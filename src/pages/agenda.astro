---
import Base from '../layouts/Base.astro';
---
<Base title='Agenda una llamada · 30 minutos sin compromiso | Morphos Marketing' description='Agenda 30 minutos con Omar Sandoval. Sin presentación de ventas: diagnóstico rápido y una respuesta honesta sobre si Morphos es la opción correcta para tu empresa.' canonical='https://www.morphosagency.com/agenda/'>
  <div class="page active" id="page-agenda">

    <section class="agd-section">
      <div class="wrap">
        <div class="agd-inner">

          <!-- LEFT: Copy -->
          <div>
            <div class="agd-label">Próximo paso</div>
            <h1 class="agd-title">Agenda tu<br>llamada.</h1>
            <p class="agd-sub">30 minutos. Sin presentación de ventas. Solo las preguntas correctas y una respuesta honesta sobre si podemos trabajar juntos.</p>

            <div class="agd-items">
              <div class="agd-item">
                <div class="agd-item-num">01</div>
                <div>
                  <div class="agd-item-title">Diagnóstico rápido</div>
                  <div class="agd-item-body">Entendemos tu situación actual: canales activos, presupuesto, objetivos y qué ha funcionado — o no.</div>
                </div>
              </div>
              <div class="agd-item">
                <div class="agd-item-num">02</div>
                <div>
                  <div class="agd-item-title">¿Somos la opción correcta?</div>
                  <div class="agd-item-body">Si tu empresa no encaja con nuestro perfil de cliente, te lo decimos en los primeros 5 minutos — sin rodeos.</div>
                </div>
              </div>
              <div class="agd-item">
                <div class="agd-item-num">03</div>
                <div>
                  <div class="agd-item-title">Siguiente paso concreto</div>
                  <div class="agd-item-body">Te damos una recomendación concreta: propuesta, siguiente conversación, o el recurso que más te ayuda en este momento.</div>
                </div>
              </div>
            </div>

            <div class="agd-btn-wrap">
              <!-- Ancla al embed (misma página): la reserva ocurre EN el sitio → GA4 sí ve el
                   generate_lead (calendly.event_scheduled solo dispara en el embed — fix 11 ago,
                   caso real: reserva invisible del 10 ago). La liga externa queda como fallback
                   CON UTMs para que Calendly guarde el origen aunque GA4 no lo vea. -->
              <a href="#calendlyWidget" class="btn btn-primary btn-lg">
                <span>Selecciona fecha y hora</span>
                <span class="arrow">→</span>
              </a>
              <p class="cta-note" style="text-align:left; margin-top:16px; color:rgba(255,255,255,0.2);">Sesión 1 a 1 con Omar · 30 minutos · Sin compromiso · <a href="https://calendly.com/omar-morphosagency/30min?utm_source=morphosagency&utm_medium=sitio&utm_campaign=agenda-fallback" target="_blank" rel="noopener" style="color:rgba(255,255,255,0.35);text-decoration:underline;">abrir en otra pestaña</a></p>
            </div>
          </div>

          <!-- RIGHT: Calendly embed. Usamos data-cal-url (NO data-url) para que el auto-init de
               Calendly lo ignore y solo nuestro init explícito cree el iframe → un solo widget. -->
          <div class="agd-cal">
            <div id="calendlyWidget"
              data-cal-url="https://calendly.com/omar-morphosagency/30min?hide_gdpr_banner=1&background_color=0d1b2a&text_color=ffffff&primary_color=7a9e7e"
              style="min-width:320px;height:660px;">
            </div>
          </div>

        </div>

        <!-- Vía 2: formulario de baja fricción (intención tibia — quien no quiere llamada aún).
             Backend: Formspree. Atribución: hidden fields desde sessionStorage (attr_* que ya
             persiste Base.astro). GA4: generate_lead method:form al éxito. -->
        <div class="agd-form-wrap">
          <div class="agd-form-head">
            <div class="agd-label">¿Aún no quieres agendar llamada?</div>
            <p class="agd-form-sub">Déjanos tus datos y te escribimos nosotros — sin llamada, sin compromiso.</p>
            <p class="agd-form-sub" style="margin-top:6px;">Si nos dejas tu sitio web, llegamos a la conversación ya con la tarea hecha.</p>
          </div>
          <form id="agdForm" method="POST" action="https://formspree.io/f/xqpzqovo" novalidate>
            <div class="agd-form-grid">
              <input type="text" name="nombre" placeholder="Tu nombre *" required autocomplete="name">
              <input type="text" name="empresa" placeholder="Empresa *" required autocomplete="organization">
              <input type="email" name="correo" placeholder="Correo *" required autocomplete="email">
              <input type="tel" name="whatsapp" placeholder="WhatsApp (opcional)" autocomplete="tel">
              <input type="url" name="sitio_web" placeholder="Sitio web de tu empresa (opcional)" autocomplete="url" class="agd-span2">
            </div>
            <textarea name="mensaje" rows="2" placeholder="¿Qué necesitas resolver? (opcional)"></textarea>
            <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off">
            <input type="hidden" name="pagina" value="/agenda/">
            <input type="hidden" name="atribucion" id="agdAttr" value="">
            <button type="submit" class="btn btn-primary">Enviar — te escribimos en menos de 1 día hábil</button>
            <p class="agd-form-ok" id="agdFormOk" hidden>Listo, nos llegó. Te escribimos en menos de 1 día hábil — revisa también tu WhatsApp si lo dejaste. 🤝</p>
            <p class="agd-form-err" id="agdFormErr" hidden>Algo falló al enviar. Escríbenos directo a <a href="mailto:info@morphosagency.com">info@morphosagency.com</a> mientras lo revisamos.</p>
          </form>
        </div>

      </div>
    </section>

  </div>

  <style>
    .agd-form-wrap { margin: 72px 0 0; padding: 44px 0 0; border-top: 1px solid rgba(255,255,255,0.10); display: grid; grid-template-columns: 0.9fr 1.5fr; gap: 48px; align-items: start; position: relative; z-index: 1; }
    .agd-form-head { margin-bottom: 0; }
    .agd-form-sub { color: rgba(255,255,255,0.55); margin-top: 10px; font-size: 0.95rem; max-width: 34ch; }
    .agd-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
    .agd-span2 { grid-column: 1 / -1; }
    #agdForm input, #agdForm textarea { width: 100%; padding: 13px 14px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.14); border-radius: 8px; color: var(--white); font: inherit; font-size: 0.95rem; }
    #agdForm input::placeholder, #agdForm textarea::placeholder { color: rgba(255,255,255,0.38); }
    #agdForm input:focus, #agdForm textarea:focus { outline: 2px solid var(--green); outline-offset: 1px; border-color: transparent; }
    #agdForm textarea { margin-bottom: 14px; resize: vertical; }
    .agd-form-ok { color: var(--green); margin-top: 14px; }
    .agd-form-err { color: #e08585; margin-top: 14px; }
    .agd-form-err a { color: inherit; text-decoration: underline; }
    @media (max-width: 900px) { .agd-form-wrap { grid-template-columns: 1fr; gap: 22px; } }
    @media (max-width: 640px) { .agd-form-grid { grid-template-columns: 1fr; } }
  </style>

  <script>
    // Formulario de baja fricción: atribución + envío AJAX + GA4. Defensivo: si JS falla,
    // el form hace POST normal a Formspree (progressive enhancement).
    function agdFormInit() {
      const f = document.getElementById('agdForm');
      if (!f || f.dataset.init === '1') return;
      f.dataset.init = '1';
      // atribución desde sessionStorage (la persiste Base.astro en cada aterrizaje)
      try {
        const keys = ['gclid','fbclid','utm_source','utm_medium','utm_campaign','utm_content','utm_term'];
        const attr = keys.map(k => { const v = sessionStorage.getItem('attr_' + k); return v ? (k + '=' + v) : null; }).filter(Boolean).join(' | ');
        const h = document.getElementById('agdAttr'); if (h) h.value = attr || 'directo/organico (sin params)';
      } catch (e) {}
      f.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const ok = document.getElementById('agdFormOk'), err = document.getElementById('agdFormErr');
        ok.hidden = true; err.hidden = true;
        if (!f.reportValidity()) return;
        const btn = f.querySelector('button[type=submit]'); btn.disabled = true;
        try {
          const r = await fetch(f.action, { method: 'POST', body: new FormData(f), headers: { 'Accept': 'application/json' } });
          if (!r.ok) throw new Error('status ' + r.status);
          f.querySelectorAll('input:not([type=hidden]):not([name=_gotcha]), textarea').forEach(el => el.value = '');
          ok.hidden = false; btn.disabled = false;
          if (typeof window.gtag === 'function') window.gtag('event', 'generate_lead', { method: 'form', value: 1, currency: 'MXN' });
        } catch (e) { err.hidden = false; btn.disabled = false; }
      });
    }
    agdFormInit();
    document.addEventListener('astro:page-load', agdFormInit);
  </script>
</Base>
